      "isDeleted": false,
      "boundElements": [],
      "updated": 1778512577484,
      "link": null,
      "locked": false,
      "text": "Meaning of the time window k\n\nThe highway system is approximately stable:\nIDM + MOBIL tend to return to normal flow\nAI behavior is a disturbance to this stability\n\nSmall k: recovery must happen soon, more conservative\nLarge k: longer recovery is allowed, more permissive",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Meaning of the time window k\n\nThe highway system is approximately stable:\nIDM + MOBIL tend to return to normal flow\nAI behavior is a disturbance to this stability\n\nSmall k: recovery must happen soon, more conservative\nLarge k: longer recovery is allowed, more permissive",
      "lineHeight": 1.25,
      "baseline": 154,
      "index": "b03",
      "autoResize": false
    },
