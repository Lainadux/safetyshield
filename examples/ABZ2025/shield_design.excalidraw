      "updated": 1778512490473,
      "link": null,
      "locked": false,
      "text": "How to check safety?\n\nUse an until operator:\nno collision U system returns to a stable state\n\nImplementation idea:\nengine.step() detects collisions\nand writes a crashed variable",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "How to check safety?\n\nUse an until operator:\nno collision U system returns to a stable state\n\nImplementation idea:\nengine.step() detects collisions\nand writes a crashed variable",
      "lineHeight": 1.25,
      "baseline": 154,
      "index": "b01",
      "autoResize": true
    },
